{
  "name": "payment-customization",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@shopify/shopify_function": "~2.0.0"
  },
  "codegen": {
    "overwrite": true,
    "schema": "schema.graphql",
    "documents": "src/**/*.graphql",
    "generates": {
      "generated/api.ts": {
        "plugins": [
          "typescript",
          "typescript-operations"
        ]
      }
    }
  }
}
